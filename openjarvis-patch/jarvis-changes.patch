+@pytest.mark.parametrize(
+    "model", ["gpt-oss:120b-cloud", "gpt-oss:20b", "gemma4:cloud", "qwen3.5:4b"]
+)
+def test_get_provider_treats_ollama_tags_as_local(model):
+    assert cloud_router.get_provider(model) is None
+
+
+def test_get_provider_keeps_openrouter_free_suffix():
+    model = "meta-llama/llama-3.3-70b-instruct:free"
+    assert cloud_router.get_provider(model) == "openrouter"
+
+
+def test_get_provider_still_detects_openai_ids():
+    assert cloud_router.get_provider("gpt-4.1-mini") == "openai"
+    assert cloud_router.get_provider("gpt-4o-2024-08-06") == "openai"
+
+
